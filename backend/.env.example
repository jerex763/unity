# Development-only example. Copy to .env and replace values as needed.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://unity:unity@localhost:5432/unity
PRIVACY_NOTICE_VERSION=2026-07-draft
PRIVACY_NOTICE_TEXT=Replace with the church-approved current privacy notice before production.
PUBLIC_REGISTRATION_RATE_LIMIT=12
PUBLIC_REGISTRATION_TOKEN_RATE_LIMIT=120
PUBLIC_REGISTRATION_RATE_WINDOW_SECONDS=600
PUBLIC_REGISTRATION_TRUSTED_PROXY_HOPS=0
